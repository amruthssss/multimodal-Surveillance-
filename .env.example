# Copy to .env, then set a unique JWT secret and your MongoDB URI. URL-encode special characters in Atlas passwords.
FLASK_SECRET=replace-with-a-random-secret-for-local-development
VIDEO_SOURCE=0
FRAME_INTERVAL=6
VIDEO_MAX_WIDTH=960
VIDEO_JPEG_QUALITY=78
SAVE_MEDIA=true
DATABASE_URL=sqlite:///data/logs/events.db
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-before-running
MONGODB_URI=mongodb://127.0.0.1:27017/surveillance
PORT=5001
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
FRONTEND_URL=http://127.0.0.1:4300,http://localhost:4300,http://localhost:3000
VITE_API_URL=http://localhost:5001/api
VITE_AI_URL=http://localhost:5000
YOLO_MODEL=yolo26n.pt
FIRE_SMOKE_MODEL_REPO=seawsurf/fire_yolo
FIRE_SMOKE_MODEL_FILE=weights/best.pt
TRAFFIC_ACCIDENT_MODEL_REPO=Enos-123/traffic-accident-detection-yolo11x
TRAFFIC_ACCIDENT_MODEL_FILE=weights/epoch61.pt
YAMNET_MODEL_REPO=audiomagic/yamnet-onnx
EVENT_MODEL_INTERVAL=6
FIRE_SMOKE_CONFIDENCE=0.45
ACCIDENT_CONFIDENCE=0.55
AUDIO_GUNSHOT_THRESHOLD=0.20
AUDIO_EXPLOSION_THRESHOLD=0.20
